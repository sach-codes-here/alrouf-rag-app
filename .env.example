############################
# Postgres connection
############################
# Recommended: set a full DSN/URL
DATABASE_URL=postgresql://alrouf_user:change_me@localhost:5432/alrouf_rag

# Or (optional) supply parts; script will build a DSN if DATABASE_URL is missing
PGHOST=localhost
PGPORT=5432
PGDATABASE=alrouf_rag
PGUSER=alrouf_user
PGPASSWORD=change_me

############################
# Source table (chunks)
############################
PG_SCHEMA=rag
CHUNKS_TABLE=ocr_markdown_chunks

############################
# Embeddings settings
############################
# Must match the model used by 04-embed-chunks.py.
# fastembed supports this well and it is lightweight:
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Same quantization scale used when writing INTEGER[] vectors
VECTOR_QUANT_SCALE=1000

############################
# Index output paths
############################
INDEX_DIR=vectorstore
FAISS_INDEX_FILE=chunks.faiss
DOCSTORE_FILE=chunks_docstore.jsonl
BM25_FILE=chunks_bm25.pkl

############################
# Hybrid search weights
############################
# alpha=1.0 => vector-only, alpha=0.0 => bm25-only
HYBRID_ALPHA=0.6
TOP_K=10

############################
# Arabic -> English translation
############################
# If you install Argos language packs, set:
ARGOS_ENABLED=true

############################
# Mock cost model (USD)
############################
COST_EMBEDDING_USD=0.5
COST_SEARCH_USD=0.2
# Optional extras
COST_TRANSLATION_USD=0.05
COST_MERGE_USD=0.01
COST_OVERHEAD_USD=0.01

